{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "statamic/statamic",
    "type": "project",
    "description": "Statamic",
    "keywords": [
        "statamic",
        "cms",
        "flat file",
        "laravel"
    ],
    "require": {
        "php": "^8.3",
        "goldnead/statamic-automations": "dev-main as 2.8.0",
        "goldnead/statamic-booking": "dev-main as 1.1.0",
        "goldnead/statamic-consent": "dev-main as 1.5.0",
        "goldnead/statamic-funnels": "dev-main as 1.3.0",
        "goldnead/statamic-marketing": "dev-main as 2.16.0",
        "goldnead/statamic-offers": "dev-main as 1.2.0",
        "goldnead/statamic-payments": "dev-main as 1.11.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "statamic/cms": "^6.0",
        "goldnead/statamic-brand-context": "*",
        "goldnead/statamic-leadhub": "dev-main as 2.6.1",
        "goldnead/statamic-suppression": "*",
        "goldnead/statamic-activity": "*",
        "goldnead/statamic-email-templates": "*",
        "goldnead/statamic-entitlements": "*",
        "goldnead/statamic-events": "*",
        "goldnead/statamic-identity-contracts": "*",
        "goldnead/statamic-lead-magnets": "*",
        "goldnead/statamic-notifications": "*",
        "goldnead/statamic-preference-center": "*",
        "goldnead/statamic-toc": "*",
        "goldnead/statamic-webhook-manager": "*",
        "goldnead/statamic-flow-canvas": "dev-main as 1.1.0",
        "goldnead/statamic-invoices": "dev-main as 1.0.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "fruitcake/laravel-debugbar": "^4.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12",
        "spatie/laravel-error-solutions": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "pre-update-cmd": [
            "Statamic\\Console\\Composer\\Scripts::preUpdateCmd"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan statamic:install --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../../statamic-funnels"
        },
        {
            "type": "path",
            "url": "../../statamic-flow-canvas"
        },
        {
            "type": "path",
            "url": "../../statamic-offers"
        },
        {
            "name": "payments",
            "type": "path",
            "url": "../../statamic-payments"
        },
        {
            "name": "booking",
            "type": "path",
            "url": "../../statamic-booking"
        },
        {
            "name": "automations",
            "type": "path",
            "url": "../../statamic-automations"
        },
        {
            "name": "marketing",
            "type": "path",
            "url": "../../statamic-marketing"
        },
        {
            "name": "consent",
            "type": "path",
            "url": "../../statamic-consent"
        },
        {
            "type": "path",
            "url": "../../statamic-leadhub"
        },
        {
            "type": "path",
            "url": "../../statamic-invoices",
            "options": {
                "symlink": true
            }
        }
    ]
}
